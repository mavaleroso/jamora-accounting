APP_NAME="Jamora BMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
ATTENDANCE_GEOFENCE_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jamora-accounting
DB_USERNAME=root
DB_PASSWORD=

# Optical POS (optical-new) accounting API — same value as ACCOUNTING_API_TOKEN in optical-new's .env.
OPTICAL_API_BASE_URL=http://optical-new.test
OPTICAL_API_TOKEN=
# true: logins copied from optical-new sign in with their optical-new password. false: the password kept here.
OPTICAL_PASSWORD_CHECK=false
# Go-live date (Y-m-d): optical records dated earlier belong in the opening balances and are not booked.
OPTICAL_SYNC_START_DATE=
# Entity that sells optical products / does edging & repair (entity codes).
OPTICAL_PRODUCT_ENTITY=JAM_OPTICUS
OPTICAL_WORKSHOP_ENTITY=JAM_OPTICUS
# Employer of a copied optical-new user whose role isn't mapped in config/optical.php.
OPTICAL_DEFAULT_USER_ENTITY=A_JAMORA
# Source documents post to the ledger immediately; set false to leave them as drafts.
ACCOUNTING_AUTO_POST_SOURCE_DOCUMENTS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
